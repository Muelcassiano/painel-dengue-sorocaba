# Configurações do Supabase para ingestão local
# Obtenha estes dados no painel do Supabase:
# 1. Project Settings > Database > Connection string > URI (Modo 'Transaction' ou 'Session', porta 5432 ou 6543)
DATABASE_URL=postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Opcional (se usar SDK REST client):
# Project Settings > API
SUPABASE_URL=https://[SEU-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...[SUA-SERVICE-ROLE-KEY-SECRETA]
